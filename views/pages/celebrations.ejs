<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/celebrations.css" />
</head>

<body>

  <%- include('../partials/navbar') %>

  <main class="celeb-page">

    <!-- ═══════════════════════════════════════════
         HERO
    ═══════════════════════════════════════════ -->
    <section class="celeb-hero">
      <div class="celeb-hero__bg"></div>
      <div class="celeb-hero__glow celeb-hero__glow--a"></div>
      <div class="celeb-hero__glow celeb-hero__glow--b"></div>
      <div class="celeb-hero__inner">
        <p class="celeb-eyebrow">✨ Joy &amp; Belonging</p>
        <h1>Celebrating Every Moment</h1>
        <p class="celeb-hero__lead">
          From Diwali lights to Christmas carols, Holi colours to birthday smiles — every celebration at
          Spread a Smile India tells our children that they are seen, loved, and worth celebrating.
        </p>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SIDEBAR + SCROLL CONTENT LAYOUT
    ═══════════════════════════════════════════ -->
    <section class="celeb-layout-section">
      <div class="container">
        <div class="celeb-layout-grid">

          <!-- ── LEFT: Sticky Sidebar Navigation ── -->
          <aside class="celeb-sidebar">
            <div class="celeb-track-wrap">
              <div class="celeb-track-line"></div>
              <div class="celeb-track-nodes">

                <button class="celeb-node is-active" data-festival="fest-diwali" style="--node-color:#f5c842">
                  <span class="celeb-node__dot-wrap"><span class="celeb-node__icon-box"><i class="fa-solid fa-fire-flame-curved"></i></span></span>
                  <span class="celeb-node__label">Diwali</span>
                </button>

                <button class="celeb-node" data-festival="fest-christmas" style="--node-color:#ef4444">
                  <span class="celeb-node__dot-wrap"><span class="celeb-node__icon-box"><i class="fa-solid fa-tree"></i></span></span>
                  <span class="celeb-node__label">Christmas</span>
                </button>

                <button class="celeb-node" data-festival="fest-holi" style="--node-color:#a855f7">
                  <span class="celeb-node__dot-wrap"><span class="celeb-node__icon-box"><i class="fa-solid fa-palette"></i></span></span>
                  <span class="celeb-node__label">Holi</span>
                </button>

                <button class="celeb-node" data-festival="fest-independence" style="--node-color:#f97316">
                  <span class="celeb-node__dot-wrap"><span class="celeb-node__icon-box"><i class="fa-solid fa-flag"></i></span></span>
                  <span class="celeb-node__label">Independence</span>
                </button>

                <button class="celeb-node" data-festival="fest-dussehra" style="--node-color:#2dd4bf">
                  <span class="celeb-node__dot-wrap"><span class="celeb-node__icon-box"><i class="fa-solid fa-sun"></i></span></span>
                  <span class="celeb-node__label">Dussehra</span>
                </button>

                <button class="celeb-node" data-festival="fest-zoo" style="--node-color:#4ade80">
                  <span class="celeb-node__dot-wrap"><span class="celeb-node__icon-box"><i class="fa-solid fa-paw"></i></span></span>
                  <span class="celeb-node__label">Zoo Visit</span>
                </button>

                <button class="celeb-node" data-festival="fest-sports" style="--node-color:#fb923c">
                  <span class="celeb-node__dot-wrap"><span class="celeb-node__icon-box"><i class="fa-solid fa-medal"></i></span></span>
                  <span class="celeb-node__label">Sports Day</span>
                </button>

                <button class="celeb-node" data-festival="fest-movie" style="--node-color:#f4607a">
                  <span class="celeb-node__dot-wrap"><span class="celeb-node__icon-box"><i class="fa-solid fa-film"></i></span></span>
                  <span class="celeb-node__label">Movie Night</span>
                </button>

                <button class="celeb-node" data-festival="fest-birthday" style="--node-color:#e879f9">
                  <span class="celeb-node__dot-wrap"><span class="celeb-node__icon-box"><i class="fa-solid fa-cake-candles"></i></span></span>
                  <span class="celeb-node__label">Birthdays</span>
                </button>

                <button class="celeb-node" data-festival="fest-cultural" style="--node-color:#38bdf8">
                  <span class="celeb-node__dot-wrap"><span class="celeb-node__icon-box"><i class="fa-solid fa-masks-theater"></i></span></span>
                  <span class="celeb-node__label">Cultural</span>
                </button>

              </div>
            </div>
          </aside>

          <!-- ── RIGHT: Scrollable Festival Content ── -->
          <div class="celeb-scroll-content">

            <!-- ── DIWALI ─────────────────────────────── -->
            <div class="celeb-festival-section" id="fest-diwali" style="--fest-color:#f5c842">
              <div class="celeb-festival-header">
                <span class="celeb-festival-eyebrow"><i class="fa-solid fa-fire-flame-curved"></i> Festival of Lights</span>
                <h2 class="celeb-festival-title">Diwali</h2>
                <p class="celeb-festival-desc">Every Diwali, our centres glow with diyas, rangoli, new clothes, and sweets — reminding every child that light always finds its way, no matter how dark the journey.</p>
              </div>

              <div class="celeb-photo-grid">
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/image%205.jpg', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/image%205.jpg', 'w-1200,q-85') %>" alt="Diwali 2024 — Children with diyas" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2024</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/outside%20event.jpg?updatedAt=1773482001263', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/outside%20event.jpg?updatedAt=1773482001263', 'w-1200,q-85') %>" alt="Diwali 2024 — Rangoli and decorations" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2024</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/8.jpg?updatedAt=1773396969419', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/8.jpg?updatedAt=1773396969419', 'w-1200,q-85') %>" alt="Diwali 2024 — Celebration gathering" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2024</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation4.jpg?tr=q-75', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation4.jpg?tr=q-75', 'w-1200,q-85') %>" alt="Diwali 2024 — Sweets distribution" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2024</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation2.jpg?tr=q-80', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation2.jpg?tr=q-80', 'w-1200,q-85') %>" alt="Diwali 2023" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2023</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/outside%20event.jpg?updatedAt=1773482001263', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/outside%20event.jpg?updatedAt=1773482001263', 'w-1200,q-85') %>" alt="Diwali 2023 — Festivities" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2023</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/image%205.jpg', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/image%205.jpg', 'w-1200,q-85') %>" alt="Diwali 2023 — Group celebration" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2023</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/slide1_education.jpg?tr=q-75', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/slide1_education.jpg?tr=q-75', 'w-1200,q-85') %>" alt="Diwali 2023 — Children gathering" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2023</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/8.jpg?updatedAt=1773396969419', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/8.jpg?updatedAt=1773396969419', 'w-1200,q-85') %>" alt="Diwali 2022" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2022</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation4.jpg?tr=q-75', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation4.jpg?tr=q-75', 'w-1200,q-85') %>" alt="Diwali 2022 — Moments" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2022</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation2.jpg?tr=q-80', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation2.jpg?tr=q-80', 'w-1200,q-85') %>" alt="Diwali 2022 — Joy" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2022</span></div></div>
              </div>
            </div>

            <!-- ── CHRISTMAS ──────────────────────────── -->
            <div class="celeb-festival-section" id="fest-christmas" style="--fest-color:#ef4444">
              <div class="celeb-festival-header">
                <span class="celeb-festival-eyebrow"><i class="fa-solid fa-tree"></i> Season of Giving</span>
                <h2 class="celeb-festival-title">Christmas</h2>
                <p class="celeb-festival-desc">Songs, decorations, Santa visits, and gift-giving — Christmas at our centre fills every child's heart with warmth, wonder, and the spirit of generosity.</p>
              </div>

              <div class="celeb-photo-grid">
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/festival/chrimas_MitvY5q8q.jpg?updatedAt=1767701878989', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/festival/chrimas_MitvY5q8q.jpg?updatedAt=1767701878989', 'w-1200,q-85') %>" alt="Christmas 2024 — Santa and children" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2024</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/outside%20event.jpg?updatedAt=1773482001263', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/outside%20event.jpg?updatedAt=1773482001263', 'w-1200,q-85') %>" alt="Christmas 2024 — Celebrations" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2024</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/8.jpg?updatedAt=1773396969419', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/8.jpg?updatedAt=1773396969419', 'w-1200,q-85') %>" alt="Christmas 2024 — Gifts" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2024</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation2.jpg?tr=q-80', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation2.jpg?tr=q-80', 'w-1200,q-85') %>" alt="Christmas 2024 — Carols" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2024</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/festival/chrimas_MitvY5q8q.jpg?updatedAt=1767701878989', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/festival/chrimas_MitvY5q8q.jpg?updatedAt=1767701878989', 'w-1200,q-85') %>" alt="Christmas 2023" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2023</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation4.jpg?tr=q-75', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation4.jpg?tr=q-75', 'w-1200,q-85') %>" alt="Christmas 2023 — Joy" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2023</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/image%205.jpg', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/image%205.jpg', 'w-1200,q-85') %>" alt="Christmas 2023 — Event" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2023</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/festival/chrimas_MitvY5q8q.jpg?updatedAt=1767701878989', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/festival/chrimas_MitvY5q8q.jpg?updatedAt=1767701878989', 'w-1200,q-85') %>" alt="Christmas 2022" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2022</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation2.jpg?tr=q-80', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation2.jpg?tr=q-80', 'w-1200,q-85') %>" alt="Christmas 2022 — Celebration" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2022</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/8.jpg?updatedAt=1773396969419', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/8.jpg?updatedAt=1773396969419', 'w-1200,q-85') %>" alt="Christmas 2022 — Program" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2022</span></div></div>
              </div>
            </div>

            <!-- ── HOLI ───────────────────────────────── -->
            <div class="celeb-festival-section" id="fest-holi" style="--fest-color:#a855f7">
              <div class="celeb-festival-header">
                <span class="celeb-festival-eyebrow"><i class="fa-solid fa-palette"></i> Festival of Colours</span>
                <h2 class="celeb-festival-title">Holi</h2>
                <p class="celeb-festival-desc">Colours, water, laughter, and music — Holi at our centres is a riot of pure joy where every child gets to be carefree, colourful, and completely themselves.</p>
              </div>

              <div class="celeb-photo-grid">
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/outside%20event.jpg?updatedAt=1773482001263', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/outside%20event.jpg?updatedAt=1773482001263', 'w-1200,q-85') %>" alt="Holi 2025 — Colour play" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2025</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/8.jpg?updatedAt=1773396969419', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/8.jpg?updatedAt=1773396969419', 'w-1200,q-85') %>" alt="Holi 2025 — Celebrations" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2025</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation4.jpg?tr=q-75', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation4.jpg?tr=q-75', 'w-1200,q-85') %>" alt="Holi 2025 — Festivities" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2025</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/image%205.jpg', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/image%205.jpg', 'w-1200,q-85') %>" alt="Holi 2025 — Fun" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2025</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation2.jpg?tr=q-80', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/transformation/transformation2.jpg?tr=q-80', 'w-1200,q-85') %>" alt="Holi 2024" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2024</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/outside%20event.jpg?updatedAt=1773482001263', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/outside%20event.jpg?updatedAt=1773482001263', 'w-1200,q-85') %>" alt="Holi 2024 — Event" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2024</span></div></div>
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/8.jpg?updatedAt=1773396969419', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/Landing%20page/carouselSlides/8.jpg?updatedAt=1773396969419', 'w-1200,q-85') %>" alt="Holi 2024 — Colours" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2024</span></div></div>
              </div>
            </div>

            <!-- ── INDEPENDENCE DAY ───────────────────── -->
            <div class="celeb-festival-section" id="fest-independence" style="--fest-color:#f97316">
              <div class="celeb-festival-header">
                <span class="celeb-festival-eyebrow"><i class="fa-solid fa-flag"></i> Pride of the Nation</span>
                <h2 class="celeb-festival-title">Independence Day</h2>
                <p class="celeb-festival-desc">Flag hoisting, patriotic songs, and marching with pride — our children learn what freedom truly means, and the responsibility that comes with it.</p>
              </div>

              <div class="celeb-photo-grid">
                <div class="celeb-photo-item"><img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/image%205.jpg', 'w-400,h-400,fo-auto,q-80') %>" data-highres="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/celebrations/image%205.jpg', 'w-1200,q-85') %>" alt="Independence Day 2024 — Flag hoisting" loading="lazy" /><div class="celeb-photo-overlay"><span class="celeb-photo-year">2024</span></div></div>
