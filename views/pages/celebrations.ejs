<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/celebrations.css?v=<%= Date.now() %>" />
</head>

<body>

  <%- include('../partials/navbar') %>

  <main class="celeb-page">

    <!-- HERO -->
    <section class="celeb-hero">
      <div class="celeb-hero__inner">
        <h1 class="celeb-hero__title">
          Festival Celebrations in<br>
          <span class="celeb-title-brand">Spread a Smile India</span>
        </h1>
      </div>
    </section>

    <!-- MAIN CELEBRATIONS SECTION (CARD UI) -->
    <section class="celeb-main-section" id="celebrationsHub">
      <div class="container">

        <!-- VIEW 1: FESTIVALS HUB (TOP-LEVEL CARDS) -->
        <div class="celeb-hub-view" id="celebHubView">
          <div class="celeb-festivals-grid" id="celebFestivalsGrid">
            <% festivals.forEach((fest) => { 
                const totalPhotos = fest.years.reduce((acc, y) => acc + (y.photos ? y.photos.length : 0), 0);
            %>
              <article class="celeb-fest-card" data-fest-id="<%= fest.id %>" style="--accent-color: <%= fest.color %>;">
                <div class="celeb-fest-card__media">
                  <img src="<%= getOptimizedImg(fest.coverImage, 'w-600,h-400,fo-auto,q-80') %>" alt="<%= fest.title %>" loading="lazy" />
                </div>

                <div class="celeb-fest-card__body">
                  <h3 class="celeb-fest-card__title"><%= fest.title %></h3>
                  <p class="celeb-fest-card__desc"><%= fest.desc %></p>
                  
                  <div class="celeb-fest-card__footer">
                    <div class="celeb-fest-card__meta">
                      <span><i class="fa-regular fa-image"></i> <%= totalPhotos %> Photos</span>
                    </div>
                    <span class="celeb-fest-card__arrow-btn">
                      <i class="fa-solid fa-chevron-right"></i>
                    </span>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        </div>

        <!-- VIEW 2: FESTIVAL DETAIL VIEW (DRILLDOWN TO YEARS & PHOTOS) -->
        <div class="celeb-detail-view" id="celebDetailView" style="display: none;">
          
          <!-- Back Bar & Breadcrumb -->
          <div class="celeb-detail-nav">
            <button class="celeb-back-btn" id="celebBackBtn" type="button">
              <i class="fa-solid fa-arrow-left"></i> All Celebrations
            </button>
            <div class="celeb-detail-breadcrumb">
              <span class="celeb-crumb-link" id="crumbHub">Celebrations</span>
              <i class="fa-solid fa-chevron-right"></i>
              <span class="celeb-crumb-current" id="crumbFestivalTitle">Diwali Celebrations</span>
              <span id="crumbYearWrap" style="display: none;">
                <i class="fa-solid fa-chevron-right"></i>
                <span class="celeb-crumb-current" id="crumbYearTitle">2024</span>
              </span>
            </div>
          </div>

          <!-- Festival Header Banner -->
          <div class="celeb-detail-header" id="celebDetailHeader">
            <div class="celeb-detail-header__eyebrow" id="celebDetailEyebrow">
              <i class="fa-solid fa-fire-flame-curved"></i> Festival of Lights
            </div>
            <h2 class="celeb-detail-header__title" id="celebDetailTitle">Diwali Celebrations</h2>
            <p class="celeb-detail-header__desc" id="celebDetailDesc">Every Diwali, our centres glow with diyas...</p>
          </div>

          <!-- Year Filter Pills Bar -->
          <div class="celeb-year-tabs" id="celebYearTabs">
            <!-- Rendered dynamically by JS -->
          </div>

          <!-- Content: Year Cards Grid (when "All" is active) OR Photos Grid -->
          <div class="celeb-drilldown-content" id="celebDrilldownContent">
            <!-- Rendered dynamically by JS -->
          </div>

        </div>

      </div>
    </section>

  </main>

  <!-- LIGHTBOX MODAL -->
  <div class="celeb-lightbox" id="celebLightbox">
    <div class="celeb-lightbox__backdrop" id="celebLightboxBackdrop"></div>
    <div class="celeb-lightbox__dialog">
      <button class="celeb-lightbox__close" id="celebLightboxClose" aria-label="Close modal"><i class="fa-solid fa-xmark"></i></button>
      
      <button class="celeb-lightbox__nav celeb-lightbox__nav--prev" id="celebLightboxPrev" aria-label="Previous photo">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      
      <div class="celeb-lightbox__media-wrap">
        <img src="" id="celebLightboxImg" alt="Enlarged celebration photo" />
        <div class="celeb-lightbox__counter" id="celebLightboxCounter">Photo 1 of 1</div>
      </div>

      <button class="celeb-lightbox__nav celeb-lightbox__nav--next" id="celebLightboxNext" aria-label="Next photo">
        <i class="fa-solid fa-chevron-right"></i>
      </button>

      <div class="celeb-lightbox__caption" id="celebLightboxCaption"></div>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <!-- Data injected for instant interactivity -->
  <script>
    window.CELEBRATIONS_DATA = <%- JSON.stringify(festivals) %>;
  </script>
  <script src="/js/celebrations.js?v=<%= Date.now() %>"></script>

</body>

</html>
