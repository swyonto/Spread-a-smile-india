  <%- include('../partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const nodes = document.querySelectorAll('.celeb-node');
      const sections = document.querySelectorAll('.celeb-festival-section');

      // Click node to smooth scroll
      nodes.forEach(node => {
        node.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = node.getAttribute('data-festival');
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      const sidebar = document.querySelector('.celeb-sidebar');

      function centerActiveNodeInSidebar(activeNode) {
        if (!sidebar || !activeNode) return;
        const nodeOffset = activeNode.offsetTop;
        const nodeHeight = activeNode.clientHeight;
        const sidebarHeight = sidebar.clientHeight;
        const targetTop = nodeOffset - (sidebarHeight / 2) + (nodeHeight / 2);
        sidebar.scrollTo({
          top: Math.max(0, targetTop),
          behavior: 'smooth'
        });
      }

      // Active tab updating automatically when scrolling (ScrollSpy)
      const observerOptions = {
        root: null,
        rootMargin: '-15% 0px -55% 0px',
        threshold: 0
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const activeId = entry.target.getAttribute('id');
            nodes.forEach(node => {
              if (node.getAttribute('data-festival') === activeId) {
                if (!node.classList.contains('is-active')) {
                  node.classList.add('is-active');
                  centerActiveNodeInSidebar(node);
                }
              } else {
                node.classList.remove('is-active');
              }
            });
          }
        });
      }, observerOptions);

      sections.forEach(section => observer.observe(section));

      // Lightbox Modal trigger
      const lightbox = document.getElementById('celebLightbox');
      const lightboxImg = document.getElementById('lightboxImg');
      const lightboxCaption = document.getElementById('lightboxCaption');
      const lightboxClose = document.getElementById('lightboxClose');
      const lightboxBackdrop = document.getElementById('lightboxBackdrop');

      document.querySelectorAll('.celeb-photo-item img').forEach(img => {
        img.addEventListener('click', () => {
          const highres = img.getAttribute('data-highres') || img.src;
          const alt = img.getAttribute('alt') || 'Celebration Photo';
          lightboxImg.src = highres;
          lightboxCaption.textContent = alt;
          lightbox.classList.add('is-open');
        });
      });

      const closeLightbox = () => lightbox.classList.remove('is-open');
      if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
      if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);
    });
  </script>

