                  </div>
                </section>

              </div>
              <!-- /program-covid -->

      </main>

      <div class="program-video-modal" id="programVideoModal" aria-hidden="true">
        <div class="program-video-modal__backdrop" data-video-close></div>
        <div class="program-video-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="programVideoTitle">
          <button class="program-video-modal__close" type="button" aria-label="Close video" data-video-close>
            <i class="fa-solid fa-xmark"></i>
          </button>
          <p class="program-video-modal__label">Program Video</p>
          <h3 id="programVideoTitle">Program Story</h3>
          <video id="programVideoPlayer" controls playsinline preload="metadata"></video>
        </div>
      </div>

      <div class="program-health-panel" id="programHealthPanel" aria-hidden="true">
        <div class="program-health-panel__header">
          <h2 id="healthPanelHeaderTitle">Health Program Details</h2>
          <button class="program-health-panel__close" type="button" aria-label="Close" data-health-panel-close>
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
        <div class="program-health-panel__scroll">
          <div class="container">
            <div class="program-health-panel__grid" id="healthPanelGrid">
              <!-- Dynamically populated cards -->
            </div>
          </div>
        </div>
      </div>

      <%- include('../partials/footer') %>

        <script src="/js/theme.js"></script>
        <script src="/js/programs.js?v=<%= Date.now() %>"></script>
        <script src="/js/covid.js?v=<%= Date.now() %>"></script>
</body>

