                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_19.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_20.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_21.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_22.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_23.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_24.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                        </div>
                      </div>

                    </div>

                    <!-- Divider Line -->
                    <hr class="covid-extra-divider" />

                    <!-- Bottom: All Videos Card Grid (Reels-style, plays on hover) -->
                    <div class="covid-videos-container">
                      <p class="covid-eyebrow">On-the-ground Action</p>
                      <h2>Helping in Pandemic</h2>
                      <p class="covid-videos-lead">Explore our full archive of operational video journals documenting
                        our team's
                        relief drives, sanitization efforts, and local vaccination mobilization support during the
                        lockdown waves.
                        Hover to play, toggle volume individually.</p>

                      <div class="covid-video-grid">
                        <% for(let i=1; i <=10; i++) { %>
                          <div class="covid-video-card">
                            <div class="covid-video-card__player">
                              <video src="https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_<%= i %>.mp4" loop
                                muted playsinline preload="metadata"></video>

                              <div class="covid-video-controls-overlay">
                                <div class="covid-video-play-overlay">
                                  <i class="fa-solid fa-play"></i>
                                </div>

                                <div class="covid-video-controls-bar">
                                  <button type="button" class="covid-video-sound-btn" aria-label="Toggle sound">
                                    <i class="fa-solid fa-volume-xmark"></i>
                                  </button>
                                </div>
                              </div>
                            </div>
                          </div>
                          <% } %>
                      </div>
                    </div>

                  </div>
                </section>

                <!-- Seamless Dense Image Grid (No Gaps) -->
                <section class="covid-seamless-grid-section">
