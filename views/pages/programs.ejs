                        alt="Vaccine mobilization camp" loading="lazy" />
                    </div>
                    <div class="covid-seamless-item">
                      <img
                        src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_10.jpg', 'w-400,h-400,fo-auto,q-80') %>"
                        alt="Cooked food relief deliveries" loading="lazy" />
                    </div>
                    <div class="covid-seamless-item">
                      <img
                        src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/covid_19/covid_19_31.jpg?updatedAt=1780859372793', 'w-400,h-400,fo-auto,q-80') %>"
                        alt="Lockdown student study kits" loading="lazy" />
                    </div>
                    <div class="covid-seamless-item">
                      <img
