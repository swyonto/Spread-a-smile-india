                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_18.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_19.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_20.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_21.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_22.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_23.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_24.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                        </div>
                      </div>

                    </div>

                    <!-- Divider Line -->
                    <hr class="covid-extra-divider" />

                    <!-- Bottom: All Videos Card Grid (Reels-style, plays on hover) -->
                    <div class="covid-videos-container">
                    
                      <h2>Helping in Pandemic</h2>
                  

                      <div class="covid-video-grid">
                        <% for(let i=1; i <=10; i++) { %>
                          <div class="covid-video-card">
                            <div class="covid-video-card__player">
                              <video src="https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_<%= i %>.mp4?tr=orig-true" loop
                                muted playsinline preload="metadata"></video>

                              <div class="covid-video-controls-overlay">
                                <div class="covid-video-play-overlay">
                                  <i class="fa-solid fa-play"></i>
                                </div>

                                <div class="covid-video-controls-bar">
                                  <button type="button" class="covid-video-sound-btn" aria-label="Toggle sound">
                                    <i class="fa-solid fa-volume-xmark"></i>
                                  </button>
                                </div>
                              </div>
                            </div>
                          </div>
                          <% } %>
                      </div>
                    </div>

                  </div>
                </section>

                <!-- Seamless Dense Image Grid (No Gaps) -->
                <section class="covid-seamless-grid-section">
                  <div class="covid-seamless-grid">
                    <div class="covid-seamless-item">
                      <img
                        src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_7.jpg', 'w-400,h-400,fo-auto,q-80') %>"
                        alt="Relief dry rations" loading="lazy" />
                    </div>
                    <div class="covid-seamless-item">
                      <img
                        src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_8.jpg', 'w-400,h-400,fo-auto,q-80') %>"
                        alt="Hygiene kit distribution" loading="lazy" />
                    </div>
                    <div class="covid-seamless-item">
                      <img
                        src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_9.jpg', 'w-400,h-400,fo-auto,q-80') %>"
                        alt="Vaccine mobilization camp" loading="lazy" />
                    </div>
                    <div class="covid-seamless-item">
                      <img
                        src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_10.jpg', 'w-400,h-400,fo-auto,q-80') %>"
                        alt="Cooked food relief deliveries" loading="lazy" />
                    </div>
                    <div class="covid-seamless-item">
                      <img
                        src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/covid_19/covid_19_31.jpg?updatedAt=1780859372793', 'w-400,h-400,fo-auto,q-80') %>"
                        alt="Lockdown student study kits" loading="lazy" />
                    </div>
                    <div class="covid-seamless-item">
                      <img
                        src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/covid_19/covid_19_32.jpg?updatedAt=1780859372744', 'w-400,h-400,fo-auto,q-80') %>"
                        alt="Frontline health screening" loading="lazy" />
                    </div>
                    <div class="covid-seamless-item">
                      <img
                        src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_13.jpg', 'w-400,h-400,fo-auto,q-80') %>"
                        alt="Delhi street children class" loading="lazy" />
                    </div>
                    <div class="covid-seamless-item">
                      <img
                        src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_14.jpg', 'w-400,h-400,fo-auto,q-80') %>"
