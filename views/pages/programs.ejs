                            alt="Masks &amp; Safety Support" loading="lazy" />
                        </div>
                        <div class="covid-card__content">
                          <span class="covid-card__tag">Hygiene Support</span>
                          <h3>Masks &amp; Safety Support</h3>
                          <p>Our team distributed masks and hygiene supplies to help families stay protected during the pandemic.</p>
                        </div>
                      </div>

                      <div class="covid-card">
                        <div class="covid-card__media">
                          <img src="https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_3.jpg"
                            alt="Meals for Hungry Families" loading="lazy" />
                        </div>
                        <div class="covid-card__content">
                          <span class="covid-card__tag">Food Support</span>
                          <h3>Meals for Hungry Families</h3>
                          <p>Freshly cooked meals were prepared and distributed when families had little or no access to food.</p>
                        </div>
                      </div>

                      <div class="covid-card">
                        <div class="covid-card__media">
                          <img src="https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_4.jpg"
                            alt="Food on Wheels" loading="lazy" />
                        </div>
                        <div class="covid-card__content">
                          <span class="covid-card__tag">Emergency Delivery</span>
                          <h3>Food on Wheels</h3>
                          <p>With special movement permissions during lockdown, our team delivered food and essential supplies directly to communities in need.</p>
                        </div>
                      </div>

                      <div class="covid-card">
                        <div class="covid-card__media">
                          <img src="https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_5.jpg"
                            alt="Lockdown Learning Sessions" loading="lazy" />
                        </div>
                        <div class="covid-card__content">
                          <span class="covid-card__tag">Learning Continuity</span>
                          <h3>Lockdown Learning Sessions</h3>
                          <p>Children continued learning through guided study sessions and educational support during school closures.</p>
                        </div>
                      </div>

                      <div class="covid-card">
                        <div class="covid-card__media">
                          <img src="https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_6.jpg"
                            alt="Reaching Those Most in Need" loading="lazy" />
                        </div>
                        <div class="covid-card__content">
                          <span class="covid-card__tag">Community Support</span>
                          <h3>Reaching Those Most in Need</h3>
                          <p>From our students' families to daily wage workers, rickshaw pullers, and vulnerable communities, support reached far beyond our centre.</p>
                        </div>
                      </div>

                    </div>
                  </div>
                </section>

                <!-- On-the-ground Video & Extra Gallery Section -->
