                  <div class="container">

                    <div class="covid-extra-layout">

                      <!-- Left: On-the-ground Video Player -->
                      <div class="covid-video-container">
                  
                        <h2>COVID Relief in Action</h2>
                        <div class="covid-video-player-wrap">
                          <video src="https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_1.mp4?tr=orig-true" controls
                            poster="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_15.jpg', 'w-800,q-80') %>"
                            preload="metadata">
                          </video>
                        </div>
                        <p class="covid-video-desc">Watch how our team worked on the ground to deliver food, ration kits, masks, and support during one of the most challenging periods in recent history.</p>
                      </div>

                      <!-- Right: Small Squarish Cards (No Text) -->
                      <div class="covid-squarish-gallery-container">
                        <p class="covid-eyebrow">More Moments</p>
                        <h2>Photo Logs</h2>
                        <div class="covid-squarish-grid">
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_16.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
                          </div>
                          <div class="covid-squarish-card">
                            <img
                              src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/programs/covid/covid_19_17.jpg', 'w-300,h-300,fo-auto,q-80') %>"
                              alt="Relief operation moment" loading="lazy" />
