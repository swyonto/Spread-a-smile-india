<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/dignitaries.css" />
</head>

<body>

  <%- include('../partials/navbar') %>

    <main>

      <!-- Hero -->
      <section class="dg-hero">
        <div class="dg-hero-inner">
          <p class="dg-hero-label">Our Supporters</p>
          <h1 class="dg-hero-heading">Global Recognition</h1>
          <p class="dg-hero-sub">Their visits stand as a testament to the commitment, care, and positive change that Spread A Smile India has brought to underprivileged children and their families over the years.
</p>
        </div>
      </section>

      <!-- Recognition Cards -->
      <section class="dg-section">
        <div class="dg-list">

          <!-- 1: Kiren Rijiju -->
          <div class="dg-card dg-reveal">
            <div class="dg-card-photo">
              <img src="/assets/ambassadors/ambassador1.jpeg" alt="With Kiren Rijiju" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">Shri Kiren Rijiju</span>
                <span class="dg-title">Minister of State for Home Affairs, Govt. of India</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="/assets/ambassadors/letter1.jpg"
                data-lightbox-caption="Letter of Recognition from Shri Kiren Rijiju — March 2017">
                <img src="/assets/ambassadors/letter1.jpg" alt="Letter from Kiren Rijiju" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Recognition &mdash; March 2017</p>
            </div>
          </div>

          <!-- 2: Kshenuka Senewiratne -->
          <div class="dg-card dg-card--flip dg-reveal">
            <div class="dg-card-photo">
              <img src="/assets/ambassadors/ambassador2.jpeg" alt="With Kshenuka Senewiratne" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">H.E. Kshenuka Senewiratne</span>
                <span class="dg-title">High Commissioner, Democratic Socialist Republic of Sri Lanka</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="/assets/ambassadors/letter2.jpg"
                data-lightbox-caption="Letter of Recognition from High Commission of Sri Lanka — December 2024">
                <img src="/assets/ambassadors/letter2.jpg" alt="Letter from High Commission of Sri Lanka"
                  loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Recognition &mdash; December 2024</p>
            </div>
          </div>

          <!-- 3: Pattarat Hongtong -->
          <div class="dg-card dg-reveal">
            <div class="dg-card-photo">
              <img
                src="https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.15%20PM.jpeg"
                alt="With Pattarat Hongtong" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">H.E. Pattarat Hongtong</span>
                <span class="dg-title">Ambassador of the Kingdom of Thailand to the Republic of India</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="/assets/ambassadors/letter3.jpg"
                data-lightbox-caption="Letter of Recommendation from Royal Thai Embassy — January 2025">
                <img src="/assets/ambassadors/letter3.jpg" alt="Letter from Royal Thai Embassy" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Recommendation &mdash; January 2025</p>
            </div>
          </div>

          <!-- 4: Omar Lisandro Castaneda Solares -->
          <div class="dg-card dg-card--flip dg-reveal">
            <div class="dg-card-photo">
              <img src="/assets/ambassadors/ambassador4.jpg" alt="With H.E. Mr. Omar Lisandro Castaneda Solares"
                loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">H.E. Mr. Omar Lisandro Castaneda Solares</span>
                <span class="dg-title">Ambassador of Guatemala to the Republic of India</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-visit-info">
                <p class="dg-visit-tag">Special Visit</p>
                <h3 class="dg-visit-heading">A Memorable Visit to Spread a Smile India</h3>
                <p class="dg-visit-text">H.E. Mr. Omar Lisandro Castaneda Solares, Ambassador of the Republic of
                  Guatemala to India, made a heartwarming visit to Spread a Smile India. He spent quality time with our
                  children — engaging warmly, sharing stories, and celebrating their progress. His visit was a moment of
                  joy, inspiration, and international solidarity that our students will cherish for years to come.</p>
                <div class="dg-visit-badges">
                  <span class="dg-visit-badge"><i class="fa-solid fa-earth-americas"></i> Republic of Guatemala</span>
                  <span class="dg-visit-badge"><i class="fa-solid fa-children"></i> Met Our Students</span>
                </div>
              </div>
              <div class="dg-letter-frame zoomable" data-lightbox-src="/assets/ambassadors/letter4.jpg"
                data-lightbox-caption="Letter of Appreciation from Embassy of Guatemala — 2025">
                <img src="/assets/ambassadors/letter4.jpg" alt="Letter from Embassy of Guatemala" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Appreciation &mdash; 2025</p>
            </div>
          </div>

          <!-- 5: S. Krishnan -->
          <div class="dg-card dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/s.krishnan2.HEIC', 'w-800,q-80') %>"
                alt="With Shri S. Krishnan, IAS" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">Shri S. Krishnan, IAS</span>
                <span class="dg-title">Secretary, Ministry of Electronics &amp; IT (MeitY), Government of India</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-visit-info">
                <p class="dg-visit-tag">Special Visit</p>
                <h3 class="dg-visit-heading">Supporting Digital Literacy &amp; Technical Skills</h3>
                <p class="dg-visit-text">Shri S. Krishnan, IAS, Secretary, Ministry of Electronics &amp; Information Technology (MeitY), visited Spread a Smile India. He interacted with students in our digital learning lab, inspected the computer curriculum, and expressed deep appreciation for the hands-on training model preparing youth for digital opportunities.</p>
                <div class="dg-visit-badges">
                  <span class="dg-visit-badge"><i class="fa-solid fa-graduation-cap"></i> MeitY Secretary</span>
          
                  <span class="dg-visit-badge"><i class="fa-solid fa-circle-info"></i> <a href="https://en.wikipedia.org/wiki/S._Krishnan" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline;">Wikipedia Profile</a></span>
                </div>
              </div>
              <div class="dg-letter-frame zoomable" data-lightbox-src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/s.krishnan1.HEIC', 'w-800,q-80') %>"
                data-lightbox-caption="Shri S. Krishnan, IAS, Secretary MeitY, interacting with students at Spread a Smile India">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/s.krishnan1.HEIC', 'w-600,q-80') %>" alt="Shri S. Krishnan Visit Photo"
                  loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Visit Photo &mdash; 2026</p>
            </div>
          </div>

          <!-- 6: H.E. Federico Salas Lotfe -->
          <div class="dg-card dg-card--split dg-reveal">
            <div class="dg-card-letter">
              <div class="dg-visit-info" style="border-bottom: none; padding-bottom: 0;">
                <p class="dg-visit-tag">Special Visit</p>
                <h2 style="font-family: 'Cormorant Garamond', serif; font-size: 1.85rem; font-weight: 700; color: var(--color-heading); margin: 0.2rem 0 0.5rem;">H.E. Federico Salas Lotfe</h2>
                <p style="font-size: 0.8rem; color: var(--color-text-muted); margin: 0 0 1rem 0;">Ambassador of Mexico to the Republic of India</p>
                <h3 class="dg-visit-heading">International Solidarity &amp; Support</h3>
                <p class="dg-visit-text">H.E. Federico Salas Lotfe, Ambassador of Mexico to India, visited Spread a Smile India to see our educational programs, community support, and classrooms. He warmly interacted with our students, commended the team's commitment to empowering children, and highlighted the importance of education in driving social change.</p>
                <div class="dg-visit-badges" style="margin-top: 0.8rem;">
                  <span class="dg-visit-badge"><i class="fa-solid fa-earth-americas"></i> Embassy of Mexico</span>
                  <span class="dg-visit-badge"><i class="fa-solid fa-circle-info"></i> <a href="https://en.wikipedia.org/wiki/Federico_Salas_Lotfe" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline;">Wikipedia Profile</a></span>
                </div>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.14%20PM.jpeg?updatedAt=1781166039639', 'w-800,q-80') %>"
                data-lightbox-caption="H.E. Federico Salas Lotfe, Ambassador of Mexico, with our students during his visit to Spread a Smile India">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.14%20PM.jpeg?updatedAt=1781166039639', 'w-600,q-80') %>" alt="H.E. Federico Salas Lotfe Visit Photo"
                  loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Visit Photo &mdash; 2026</p>
            </div>
          </div>

          <!-- 7: Lockheed Martin Leadership -->
          <div class="dg-card dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.15%20PM%20(1).jpeg?updatedAt=1781166039655', 'w-800,q-80') %>"
                alt="With Mara Motherway and William Blair" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">Mara Motherway &amp; William Blair</span>
                <span class="dg-title">Leadership, Lockheed Martin Corporation</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-visit-info">
                <p class="dg-visit-tag">Special Visit</p>
                <h3 class="dg-visit-heading">Corporate Social Responsibility &amp; Support</h3>
                <p class="dg-visit-text">Mara Motherway (VP, Strategy and Business Development, Lockheed Martin Aeronautics) and William Blair (VP and Regional Chief Executive, Lockheed Martin India) visited Spread a Smile India. They toured our learning center and interacted with the students, reviewing our digital and classroom learning infrastructure. They commended the NGO's dedicated efforts in bringing high-quality digital and academic education to under-resourced communities.</p>
                <div class="dg-visit-badges">
                  <span class="dg-visit-badge"><i class="fa-solid fa-industry"></i> Lockheed Martin</span>
                  <span class="dg-visit-badge"><i class="fa-solid fa-briefcase"></i> Commended Learning Centers</span>
                </div>
              </div>
              <div class="dg-letter-frame zoomable" data-lightbox-src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.15%20PM%20(1).jpeg?updatedAt=1781166039655', 'w-800,q-80') %>"
                data-lightbox-caption="Mara Motherway and William Blair of Lockheed Martin with the team at Spread a Smile India">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.15%20PM%20(1).jpeg?updatedAt=1781166039655', 'w-600,q-80') %>" alt="Lockheed Martin Leadership Visit Photo"
                  loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Visit Photo &mdash; 2026</p>
            </div>
          </div>

          <!-- 8: World Economic Forum Delegation -->
          <div class="dg-card dg-card--flip dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.14%20PM%20(1).jpeg?updatedAt=1781166039688', 'w-800,q-80') %>"
                alt="World Economic Forum Delegation Visit" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">World Economic Forum Delegation</span>
                <span class="dg-title">Global Social Impact Representatives</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-visit-info">
                <p class="dg-visit-tag">Special Visit</p>
                <h3 class="dg-visit-heading">Representatives and delegates from the World Economic Forum </h3>
                <p class="dg-visit-text">visited Spread a Smile India. They reviewed our educational models, nutrition programs, and community-led vocational initiatives. The delegation commended the grass-roots, sustainable approach in driving digital inclusion, educational opportunity, and economic empowerment for street children and mothers.</p>
                <div class="dg-visit-badges">
                  <span class="dg-visit-badge"><i class="fa-solid fa-globe"></i> World Economic Forum</span>
                  <span class="dg-visit-badge"><i class="fa-solid fa-users-gear"></i> Reviewed Social Impact</span>
                </div>
              </div>
              <div class="dg-letter-frame zoomable" data-lightbox-src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.13%20PM.jpeg?updatedAt=1781166032929', 'w-800,q-80') %>"
                data-lightbox-caption="World Economic Forum delegation members meeting and interacting with our team during their special visit">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.13%20PM.jpeg?updatedAt=1781166032929', 'w-600,q-80') %>" alt="World Economic Forum Visit Photo"
                  loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Visit Photo &mdash; 2026</p>
            </div>
          </div>

        </div>
      </section>

    </main>

    <!-- Lightbox Modal for Zooming Recommendation Letters -->
    <div class="timeline-lightbox" id="timelineLightbox" aria-hidden="true" role="dialog">
      <div class="timeline-lightbox__backdrop" id="lightboxCloseBackdrop"></div>
      <div class="timeline-lightbox__dialog">
        <button class="timeline-lightbox__close" id="lightboxCloseBtn" type="button" aria-label="Close image">
          <i class="fa-solid fa-xmark"></i>
        </button>
        <div class="timeline-lightbox__media-wrap">
          <img id="lightboxImg" src="" alt="Zoomed Letter" />
        </div>
        <div class="timeline-lightbox__caption-bar">
          <p id="lightboxCaption">Appreciation Letter Details</p>
        </div>
      </div>
    </div>

    <%- include('../partials/footer') %>

      <script src="/js/theme.js"></script>
      <script src="/js/navbar.js"></script>
      <script src="/js/dignitaries.js"></script>
</body>

</html>