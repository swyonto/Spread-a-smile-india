<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/dignitaries.css" />
</head>

<body>

  <%- include('../partials/navbar') %>

    <main>

      <!-- Hero -->
      <section class="dg-hero">
        <div class="dg-hero-inner">
          <p class="dg-hero-label">Our Supporters</p>
          <h1 class="dg-hero-heading">Global Recognition</h1>
          <p class="dg-hero-sub">Their visits stand as a testament to the commitment, care, and positive change that Spread A Smile India has brought to underprivileged children and their families over the years.</p>
        </div>
      </section>

      <!-- Recognition Cards -->
      <section class="dg-section">
        <div class="dg-list">

          <!-- 1: Shri Kiren Rijiju (Normal: Photo Left, Letter Right) -->
          <div class="dg-card dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/ambassador1.jpeg?updatedAt=1780858533089', 'w-800,q-80') %>" alt="With Shri Kiren Rijiju" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">Shri Kiren Rijiju</span>
                <span class="dg-title">Union Cabinet Minister (Former Minister of State for Home Affairs, Govt. of India)</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/letter1.png?updatedAt=1784362191719"
                data-lightbox-caption="Letter of Recognition from Shri Kiren Rijiju — March 2017">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/letter1.png?updatedAt=1784362191719', 'w-800,q-80') %>" alt="Letter from Shri Kiren Rijiju" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Recognition &mdash; March 2017</p>
            </div>
          </div>

          <!-- 2: H.E. Kshenuka Senewiratne (Flipped: Letter Left, Photo Right) -->
          <div class="dg-card dg-card--flip dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/ambassador2.jpeg?updatedAt=1780858534808', 'w-800,q-80') %>" alt="With H.E. Kshenuka Senewiratne" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">H.E. Kshenuka Senewiratne</span>
                <span class="dg-title">High Commissioner, Democratic Socialist Republic of Sri Lanka</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/letter2.png?updatedAt=1784362192245"
                data-lightbox-caption="Letter of Recognition from High Commission of Sri Lanka — December 2024">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/letter2.png?updatedAt=1784362192245', 'w-800,q-80') %>" alt="Letter from High Commission of Sri Lanka" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Recognition &mdash; December 2024</p>
            </div>
          </div>

          <!-- 3: H.E. Pattarat Hongtong (Normal: Photo Left, Letter Right) -->
          <div class="dg-card dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.15%20PM.jpeg?updatedAt=1781166039677', 'w-800,q-80') %>" alt="With H.E. Pattarat Hongtong" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">H.E. Pattarat Hongtong</span>
                <span class="dg-title">Ambassador of the Kingdom of Thailand to the Republic of India</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/letter3.png?updatedAt=1784362191691"
                data-lightbox-caption="Letter of Recommendation from Royal Thai Embassy — January 2025">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/letter3.png?updatedAt=1784362191691', 'w-800,q-80') %>" alt="Letter from Royal Thai Embassy" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Recommendation &mdash; January 2025</p>
            </div>
          </div>

          <!-- 4: Shri S. Krishnan, IAS (Flipped: Letter Left, Photo Right - Letter 4) -->
          <div class="dg-card dg-card--flip dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/s.krishnan1.HEIC?updatedAt=1782322696710', 'w-800,q-80') %>" alt="Shri S. Krishnan, IAS Visit Photo" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">Shri S. Krishnan, IAS</span>
                <span class="dg-title">Secretary, Ministry of Electronics &amp; IT (MeitY), Government of India</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/letter4.png?updatedAt=1784362192127"
                data-lightbox-caption="Letter of Appreciation from Ministry of Electronics & IT (MeitY) — Shri S. Krishnan, IAS">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/letter4.png?updatedAt=1784362192127', 'w-800,q-80') %>" alt="Letter of Appreciation from Shri S. Krishnan, IAS" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Appreciation &mdash; MeitY, Govt. of India</p>
            </div>
          </div>

          <!-- 5: H.E. Mr. Omar Lisandro Castaneda Solares (Normal: Photo Left, Letter Right - Letter 5) -->
          <div class="dg-card dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/ambassador4.jpg?updatedAt=1780858538366', 'w-800,q-80') %>" alt="With H.E. Mr. Omar Lisandro Castaneda Solares" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">H.E. Mr. Omar Lisandro Castaneda Solares</span>
                <span class="dg-title">Ambassador of Guatemala to the Republic of India</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/letter6.png?updatedAt=1784362191889"
                data-lightbox-caption="Letter of Appreciation from Embassy of Guatemala">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/letter6.png?updatedAt=1784362191889', 'w-800,q-80') %>" alt="Letter from Embassy of Guatemala" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Appreciation &mdash; Embassy of Guatemala</p>
            </div>
          </div>

          <!-- 6: H.E. Federico Salas Lotfe (Flipped: Letter Left, Photo Right - Letter 6) -->
          <div class="dg-card dg-card--flip dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.14%20PM.jpeg?updatedAt=1781166039639', 'w-800,q-80') %>" alt="With H.E. Federico Salas Lotfe" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">H.E. Federico Salas Lotfe</span>
                <span class="dg-title">Ambassador of Mexico to the Republic of India</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/letter5.png?updatedAt=1784362192018"
                data-lightbox-caption="Letter of Appreciation from Embassy of Mexico">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/letter5.png?updatedAt=1784362192018', 'w-800,q-80') %>" alt="Letter from Embassy of Mexico" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Appreciation &mdash; Embassy of Mexico</p>
            </div>
          </div>

          <!-- 7: UNESCO (Normal: Photo Left, Letter Right - Letter 7) -->
          <div class="dg-card dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/OIP%20(2).webp', 'w-800,q-80') %>" alt="UNESCO Delegation & Representatives" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">UNESCO</span>
                <span class="dg-title">United Nations Educational, Scientific and Cultural Organization</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/letter7.png?updatedAt=1784362191822"
                data-lightbox-caption="Letter of Appreciation & Recognition from UNESCO">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/letter7.png?updatedAt=1784362191822', 'w-800,q-80') %>" alt="Letter of Appreciation from UNESCO" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Appreciation &mdash; UNESCO</p>
            </div>
          </div>

          <!-- 8: Royal Norwegian Embassy & Ambassador (Flipped: Letter Left, Photo Right - Letter 8) -->
          <div class="dg-card dg-card--flip dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/switterland.HEIC', 'w-800,q-80') %>" alt="Royal Norwegian Embassy Visit Photo" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">Royal Norwegian Embassy</span>
                <span class="dg-title">Embassy of Norway to the Republic of India</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/letter8.png"
                data-lightbox-caption="Letter of Recognition & Appreciation from Royal Norwegian Embassy">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/letter8.png', 'w-800,q-80') %>" alt="Letter from Royal Norwegian Embassy" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Recognition &mdash; Royal Norwegian Embassy</p>
            </div>
          </div>

          <!-- 9: Embassy of Switzerland (Normal: Photo Left, Letter Right - Letter 9) -->
          <div class="dg-card dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/IMG_3412.heic', 'w-800,q-80') %>" alt="Embassy of Switzerland Visit Photo" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">Embassy of Switzerland</span>
                <span class="dg-title">Embassy of Switzerland to the Republic of India</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/letter9.png"
                data-lightbox-caption="Letter of Recognition & Appreciation from Embassy of Switzerland">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/letter9.png', 'w-800,q-80') %>" alt="Letter from Embassy of Switzerland" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Recognition &mdash; Embassy of Switzerland</p>
            </div>
          </div>

          <!-- 10: Shri Amitabh Kant (Flipped: Photo Left, Letter Right) -->
          <div class="dg-card dg-card--flip dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/shir%20kant.JPG', 'w-800,q-80') %>" alt="With Shri Amitabh Kant" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">Shri Amitabh Kant</span>
                <span class="dg-title">G20 Sherpa of India &amp; Former CEO, NITI Aayog</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-letter-frame zoomable" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/%7BF4ED91A8-4996-4CD8-A688-911240B40EC9%7D.png"
                data-lightbox-caption="Letter of Appreciation from Shri Amitabh Kant — G20 Sherpa & Former CEO, NITI Aayog">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/%7BF4ED91A8-4996-4CD8-A688-911240B40EC9%7D.png', 'w-800,q-80') %>" alt="Letter from Shri Amitabh Kant" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Letter of Appreciation &mdash; Shri Amitabh Kant</p>
            </div>
          </div>

          <!-- 11: Mrs. hooda (Normal: Photo 1 + Photo 2 Showcase) -->
          <div class="dg-card dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/b6fb25cd-e958-46f5-ac5f-f05f352b3898.JPG', 'w-800,q-80') %>" alt="Mrs. hooda Visit" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">Mrs. hooda</span>
                <span class="dg-title">International Representative &amp; Global Ambassador</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-photo-frame zoomable" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/miss%20hooda.HEIC"
                data-lightbox-caption="Visit Highlight & Interaction with Mrs. hooda">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/miss%20hoda.HEIC', 'w-800,q-80') %>" alt="Visit Photo of Mrs. hooda" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption">Visit Highlight &mdash; Cultural Exchange &amp; Support</p>
            </div>
          </div>

          <!-- 12: Lockheed Martin (Flipped: Corporate Partnership Showcase) -->
          <div class="dg-card dg-card--flip dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/20250319_160725%20(1).jpg', 'w-800,q-80') %>" alt="Lockheed Martin Delegation Visit" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">Lockheed Martin</span>
                <span class="dg-title">Global Corporate Partner &amp; CSR Contributor</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-visit-info">
                <p class="dg-visit-tag"><i class="fa-solid fa-building-flag"></i> Corporate Leadership</p>
                <h3 class="dg-visit-heading">CSR Partnership &amp; Impact</h3>
                <p class="dg-visit-text">Empowering underprivileged children and youth initiatives through dedicated Corporate Social Responsibility (CSR) programs, educational outreach, and community welfare.</p>
                <div class="dg-visit-badges">
                  <span class="dg-visit-badge"><i class="fa-solid fa-handshake"></i> CSR Partner</span>
                  <span class="dg-visit-badge"><i class="fa-solid fa-graduation-cap"></i> Education Support</span>
                  <span class="dg-visit-badge"><i class="fa-solid fa-heart"></i> Community Outreach</span>
                </div>
              </div>
              <div class="dg-photo-frame zoomable" style="height: 150px; flex: none; width: 100%; margin-top: 0.5rem;" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/20250319_160725%20(1).jpg" data-lightbox-caption="Lockheed Martin Corporate Visit & Delegation Interaction">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/20250319_160725%20(1).jpg', 'w-800,q-80') %>" alt="Lockheed Martin Visit Zoomable Photo" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
            </div>
          </div>

          <!-- 13: Deputy Ambassador of Norway Martine & Author Helga Flatland -->
          <div class="dg-card dg-reveal">
            <div class="dg-card-photo">
              <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.14%20PM%20(1).jpeg?updatedAt=1781166039688', 'w-800,q-80') %>" alt="Visit of Deputy Ambassador Martine and Author Helga Flatland" loading="lazy" />
              <div class="dg-card-name">
                <span class="dg-name">Deputy Ambassador Martine &amp; Helga Flatland</span>
                <span class="dg-title">Deputy Ambassador of Norway &amp; Renowned Norwegian Author</span>
              </div>
            </div>
            <div class="dg-card-letter">
              <div class="dg-visit-info" style="padding-bottom: 0.5rem; margin-bottom: 0.5rem; border-bottom: 1px solid var(--color-border); flex: none;">
                <p class="dg-visit-text" style="font-size: 0.9rem; line-height: 1.5; margin: 0;">An inspiring day at our center with Her Excellency, Deputy Ambassador of Norway, Martine, and author Helga Flatland, sharing heartwarming storybooks of friendship, courage, and kindness with our children.</p>
              </div>
              <div class="dg-photo-frame zoomable" style="flex: 1; min-height: 220px;" data-lightbox-src="https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.13%20PM.jpeg?updatedAt=1781166032929"
                data-lightbox-caption="Visit of Her Excellency, Deputy Ambassador of Norway Martine, and renowned Norwegian author Helga Flatland — bringing joy, storybooks, and inspiration to our children.">
                <img src="<%= getOptimizedImg('https://ik.imagekit.io/l15cczdgu/ambassadors/WhatsApp%20Image%202026-06-09%20at%203.47.13%20PM.jpeg', 'w-800,q-80') %>" alt="Visit Photo of Deputy Ambassador Martine and Author Helga Flatland" loading="lazy" />
                <span class="dg-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i> Click to Zoom</span>
              </div>
              <p class="dg-letter-caption" style="margin-top: 0.4rem;">Visit Highlight &mdash; Storybooks &amp; Cultural Interaction</p>
            </div>
          </div>

        </div>
      </section>

    </main>

    <!-- Lightbox Modal for Zooming Recommendation Letters -->
    <div class="timeline-lightbox" id="timelineLightbox" aria-hidden="true" role="dialog">
      <div class="timeline-lightbox__backdrop" id="lightboxCloseBackdrop"></div>
      <div class="timeline-lightbox__dialog">
        <button class="timeline-lightbox__close" id="lightboxCloseBtn" type="button" aria-label="Close image">
          <i class="fa-solid fa-xmark"></i>
        </button>
        <div class="timeline-lightbox__media-wrap">
          <img id="lightboxImg" src="" alt="Zoomed Letter" />
        </div>
        <div class="timeline-lightbox__caption-bar">
          <p id="lightboxCaption">Appreciation Letter Details</p>
        </div>
      </div>
    </div>

    <%- include('../partials/footer') %>

      <script src="/js/theme.js"></script>
      <script src="/js/dignitaries.js"></script>
</body>

</html>